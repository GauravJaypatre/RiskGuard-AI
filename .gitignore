# ==============================================================================
# RiskGuard AI — .gitignore
# ==============================================================================

# 1. Environment variables & credentials (CRITICAL: Never commit)
.env
*.env
!.env.example

# 2. Python runtime & byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 3. Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Testing & Code Quality Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 5. Node.js / Dashboard build artifacts & dependencies
node_modules/
dashboard/node_modules/
dashboard/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 6. Generated pipeline data (large outputs, regenerable via pipeline)
data/raw/
data/splits/
data/features/
data/scenarios/
data/cases/
data/*.csv
data/*.parquet

# 7. Operating System & Local IDE files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
